# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reports / tooling outputs
eslint-output.txt
eslint.json

# raw source datasets (local processing inputs — too large, never deployed)
full json/

# Next.js boilerplate SVGs (not used in the app)
public/file.svg
public/globe.svg
public/next.svg
public/vercel.svg
public/window.svg

# developer-only data-fetch & one-off fix scripts (not needed in repo)
scripts_other/*
scripts/*

README.md
Help.md
graphify-out/

# AI tooling config files (not for collaborators)
CLAUDE.md

# Backup files created by bulk-replace scripts
*.bak.*
**/*.bak.*
